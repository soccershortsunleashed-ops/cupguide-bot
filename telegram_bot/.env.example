# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Backend API
BACKEND_URL=http://127.0.0.1:8000

# MegaLLM Configuration
MEGALLM_API_KEY=your_megallm_api_key
MEGALLM_BASE_URL=https://ai.megallm.io/v1

# Consent Configuration
CONSENT_VERSION=1.0
CONSENT_TEXT=🤖 **Согласие на обработку персональных данных**

Для работы бота необходимо ваше согласие на:
• Обработку персональных данных (имя, телефон, сообщения)
• Сохранение истории переписки для улучшения качества консультаций
• Анализ ваших интересов для персонализации рекомендаций

Ваши данные используются только для предоставления услуг бота и не передаются третьим лицам.

Согласны ли вы на обработку персональных данных?

# Redis (optional, for production)
# REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=INFO