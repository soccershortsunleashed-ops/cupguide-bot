# ===========================================
# CupGuide - Git Ignore Configuration
# ===========================================

# Environment variables (NEVER commit secrets!)
.env
telegram_bot/.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo
.cursor/
.kiro/

# Testing
.pytest_cache/
.hypothesis/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# Logs
logs/
*.log
app/logs/

# Data files (may contain sensitive info)
data/
!data/.gitkeep
app/data/

# Session files
session/
*.session
app/session/

# Backups
backups/
temp_*/
temp_latest_backup/
temp_restore/
*.backup
*.bak

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp

# Media uploads (large files)
static/
app/static/media/
app/static/avatars/
app/static/tournaments/

# Development/test scripts (not needed in repo)
*_test.py
test_*.py
!tests/test_*.py
debug_*.py
check_*.py
fix_*.py
add_*.py
auto_*.py
bot_*.py
!telegram_bot/bot.py
*_backup.py
*_broken.py
*_fixed.py

# Task files (local notes)
*задача.md
Задание*.md
SYSTEM_PROMPT*.md

# Report files (generated)
*_REPORT.md
*_SUMMARY.md
*_FIX*.md
*_STATUS*.md
DIAGNOSTIC*.md
STATUS*.md

# HTML test files
*_test.html
test_*.html
*_page.html
*_updated.html
new_*.html
edit_*.html

# Misc scripts
*.bat
*.ps1
run_*.py
!run.py
start_*.py
final_*.py
simple_*.py
comprehensive_*.py
minimal_*.py
demo_*.py
