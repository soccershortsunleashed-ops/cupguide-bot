# ===========================================
# CupGuide - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env file with real secrets!

# ===========================================
# Telegram Bot Configuration
# ===========================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ===========================================
# Backend API
# ===========================================
BACKEND_URL=http://127.0.0.1:8000

# ===========================================
# LLM Configuration (MegaLLM)
# ===========================================
MEGALLM_API_KEY=your_megallm_api_key_here
MEGALLM_BASE_URL=https://ai.megallm.io/v1

# ===========================================
# JWT Secret (for WebApp authentication)
# ===========================================
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_jwt_secret_key_here

# ===========================================
# WebApp Cabinet URL (optional)
# ===========================================
# Set this to enable Telegram Mini App for cabinet
# Example: WEBAPP_CABINET_URL=https://yourdomain.com/api/cabinet/app
# WEBAPP_CABINET_URL=

# ===========================================
# Consent Configuration
# ===========================================
CONSENT_VERSION=1.0

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=INFO

# ===========================================
# Avito Bot Configuration
# ===========================================
# Avito API credentials (get from Avito Pro)
AVITO_CLIENT_ID=your_avito_client_id
AVITO_CLIENT_SECRET=your_avito_client_secret
AVITO_USER_ID=your_avito_user_id

# Webhook secret for signature verification (optional)
AVITO_WEBHOOK_SECRET=your_webhook_secret

# Polling interval in seconds (if using polling instead of webhook)
AVITO_POLLING_INTERVAL=10

# LLM timeout in seconds
LLM_TIMEOUT=30

# CRM API URL for lead creation
CRM_API_URL=http://localhost:8000/api/leads
