# Freelance Bot Configuration

# Telegram Bot Token (получить у @BotFather)
FREELANCE_BOT_TOKEN=your_bot_token_here

# Bot username (без @)
FREELANCE_BOT_USERNAME=your_bot_username

# Owner Telegram ID (для уведомлений)
OWNER_TELEGRAM_ID=123456789
OWNER_USERNAME=your_username

# MegaLLM API
MEGALLM_API_KEY=your_megallm_api_key
MEGALLM_BASE_URL=https://api.mega-llm.com/v1

# Backend URL
BACKEND_URL=http://127.0.0.1:8000

# Logging
LOG_LEVEL=INFO
